{
    "name": "doppar/bloom",
    "description": "Doppar Bloom is a high-performance package for probabilistic set membership testing, providing Bloom filter implementations with hashing algorithms",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/doppar/bloom/issues",
        "source": "https://github.com/doppar/bloom"
    },
    "authors": [
        {
            "name": "Mahedi Hasan",
            "email": "mahedy150101@gmail.com"
        }
    ],
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.1.5"
    },
    "autoload": {
        "psr-4": {
            "Doppar\\Bloom\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
